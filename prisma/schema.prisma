// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Destination {
  id              String  @id @default(uuid())
  name            String
  country         String
  state           String?
  description     String? @db.Text
  latitude        Float
  longitude       Float
  averageBudget   Float?  @map("average_budget")
  popularityScore Float   @default(0) @map("popularity_score")
  status          String  @default("active")

  attractions      Attraction[]
  localExperiences LocalExperience[]
  interests        DestinationInterest[]
  trending         TrendingDestination[]
  media            DestinationMedia[]

  @@map("destinations")
}

model Attraction {
  id            String  @id @default(uuid())
  destinationId String  @map("destination_id")
  name          String
  description   String? @db.Text
  category      String?
  latitude      Float?
  longitude     Float?
  estimatedCost Float?  @map("estimated_cost")
  openingHours  String? @map("opening_hours")
  status        String  @default("active")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  arAssets    ArAsset[]

  @@map("attractions")
}

model LocalExperience {
  id              String  @id @default(uuid())
  destinationId   String  @map("destination_id")
  name            String
  description     String? @db.Text
  category        String?
  estimatedCost   Float?  @map("estimated_cost")
  durationMinutes Int?    @map("duration_minutes")
  popularityScore Float?  @map("popularity_score")
  isHiddenGem     Boolean @default(false) @map("is_hidden_gem")
  status          String  @default("active")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@map("local_experiences")
}

model DestinationInterest {
  destinationId  String @map("destination_id")
  interest       String
  relevanceScore Float? @map("relevance_score")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([destinationId, interest])
  @@map("destination_interests")
}

model TrendingDestination {
  id            String    @id @default(uuid()) @map("trend_id")
  destinationId String    @map("destination_id")
  trendScore    Float     @map("trend_score")
  rank          Int
  calculatedAt  DateTime  @default(now()) @map("calculated_at")
  expiresAt     DateTime? @map("expires_at")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@map("trending_destinations")
}

model WebChatConversation {
  id        String   @id @default(uuid()) @map("conversation_id")
  visitorId String   @map("visitor_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  status    String   @default("active")

  messages     WebChatMessage[]
  planPreviews WebPlanPreview[]

  @@map("web_chat_conversations")
}

model WebChatMessage {
  id             String   @id @default(uuid()) @map("message_id")
  conversationId String   @map("conversation_id")
  role           String
  message        String   @db.Text
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation WebChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("web_chat_messages")
}

model WebPlanPreview {
  id             String   @id @default(uuid()) @map("preview_id")
  conversationId String   @map("conversation_id")
  destination    String
  durationDays   Int?     @map("duration_days")
  budget         Float?
  interests      String[]
  travelStyle    String?  @map("travel_style")
  previewData    Json?    @map("preview_data")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation WebChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("web_plan_previews")
}

model DestinationMedia {
  id            String   @id @default(uuid()) @map("media_id")
  destinationId String   @map("destination_id")
  mediaType     String   @map("media_type")
  objectKey     String   @map("object_key")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@map("destination_media")
}

model ArAsset {
  id           String @id @default(uuid()) @map("asset_id")
  attractionId String @map("attraction_id")
  assetType    String @map("asset_type")
  objectKey    String @map("object_key")
  metadata     Json?
  version      Int    @default(1)

  attraction Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@map("ar_assets")
}
